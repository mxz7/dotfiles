# font
font-size = 14
font-thicken = true
font-thicken-strength = 0

font-family = firamono nerd font mono

adjust-cell-height = 3%

# background blur
background-opacity = 0.9
background-blur = macos-glass-clear

# keybinds
keybind = super+backspace=text:\x15
keybind = opt+backspace=text:\x17

# window
window-colorspace = display-p3

window-padding-balance = true
window-padding-color = background
window-padding-x = 5
window-padding-y = 3

window-height = 35
window-width = 140

scrollback-limit = 256000000

theme = ayu mirage
cursor-color = #cccac2
cursor-text = #1f2430

macos-titlebar-proxy-icon = hidden

shell-integration-features = ssh-env,no-cursor
cursor-style = block
